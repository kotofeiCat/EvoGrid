name: Build and Deploy EvoGrid

# Собираем проект прямо на сервере: по сети идёт только git pull (несколько сотен КБ),
# а не ~400 МБ jar-файлов через scp, на котором деплой зависал.

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

concurrency:
  group: deploy-production
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 40

    steps:
      - name: Deploy on server (git pull + build + docker compose)
        uses: appleboy/ssh-action@v1.2.0
        env:
          REPO_URL: https://github.com/${{ github.repository }}.git
          BRANCH: ${{ github.ref_name }}
          YANDEX_MAPS_API_KEY: ${{ secrets.YANDEX_MAPS_API_KEY }}
        with:
          host: ${{ secrets.SSH_HOST }}
          username: ${{ secrets.SSH_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          port: 49351
          timeout: 60s
          command_timeout: 35m
          envs: REPO_URL,BRANCH,YANDEX_MAPS_API_KEY
          script: |
            set -e

            # Папка, куда репозиторий склонирован на сервере (поменяйте, если путь другой)
            APP_DIR=/var/www/EvoGrid
            # Имя compose-проекта = имя папки в нижнем регистре,
            # как при ручном запуске `docker compose up` из папки EvoGrid (том evogrid_postgres_data)
            PROJECT=evogrid

            # 0. Swap, чтобы сборка и 7 JVM не вешали сервер
            if [ ! -f /swapfile ]; then
              fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
              chmod 600 /swapfile
              mkswap /swapfile
              swapon /swapfile
              echo '/swapfile none swap sw 0 0' >> /etc/fstab
            else
              swapon /swapfile 2>/dev/null || true
            fi

            # 1. Получаем свежий код
            if [ ! -d "$APP_DIR/.git" ]; then
              git clone --branch "$BRANCH" "$REPO_URL" "$APP_DIR"
            fi
            cd "$APP_DIR"
            git fetch --depth 1 origin "$BRANCH"
            git reset --hard FETCH_HEAD
            git clean -fdx -e .env
            echo "Деплой коммита: $(git log -1 --format='%h %s')"

            # 2. Сборка Maven внутри Docker (Maven/JDK на сервере не нужны).
            #    Зависимости кэшируются в томе evogrid-m2, повторные сборки быстрые.
            docker run --rm \
              -v "$APP_DIR":/build -w /build \
              -v evogrid-m2:/root/.m2 \
              -e MAVEN_OPTS="-Xmx768m" \
              maven:3.9-eclipse-temurin-17 \
              mvn -B -q clean package -DskipTests

            # 3. .env (кавычки вокруг EOF — bash ничего не подставляет)
            cat <<'EOF' > .env
            POSTGRES_USER=postgres
            POSTGRES_PASSWORD=postgres
            POSTGRES_DB=postgres
            USER_DB_NAME=user_db
            POKEMON_DB_NAME=pokemon_db
            WORLD_DB_NAME=world_db
            BATTLE_DB_NAME=battle_db
            JWT_SECRET=EvoGridSuperSecretKeyForJwtSigning2026CloudMvpProject!
            EOF
            echo "YANDEX_MAPS_API_KEY=${YANDEX_MAPS_API_KEY}" >> .env

            # 4. Убираем старые контейнеры и поднимаем всё заново
            docker rm -f discovery-server config-server pokemon-service user-service world-service battle-service api-gateway evogrid-postgres 2>/dev/null || true

            docker compose -p "$PROJECT" build
            if ! docker compose -p "$PROJECT" up -d --remove-orphans --wait --wait-timeout 420; then
              echo "::error::Сервисы не поднялись. Последние логи:"
              docker compose -p "$PROJECT" ps -a
              for s in discovery-server config-server pokemon-service user-service world-service battle-service api-gateway; do
                echo "===== $s ====="
                docker compose -p "$PROJECT" logs --tail=60 "$s" || true
              done
              exit 1
            fi

            docker image prune -f
            docker compose -p "$PROJECT" ps

            # 5. Проверяем, что шлюз отвечает
            for i in $(seq 1 30); do
              if curl -fsS -o /dev/null http://127.0.0.1:8080/; then echo "api-gateway OK"; exit 0; fi
              sleep 5
            done
            echo "::error::api-gateway не отвечает на :8080"
            docker compose -p "$PROJECT" logs --tail=100 api-gateway
            exit 1
