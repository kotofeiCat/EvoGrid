name: Build and Deploy EvoGrid

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: maven

      - name: Build all microservices with Maven
        run: mvn clean package -DskipTests -T 1C

      - name: Prepare deployment archive
        run: |
          mkdir -p deploy_pkg/init-scripts
          cp docker-compose.yml Dockerfile .dockerignore deploy_pkg/
          cp -r init-scripts/* deploy_pkg/init-scripts/

          for service in config-server discovery-server api-gateway user-service pokemon-service world-service battle-service; do
            mkdir -p "deploy_pkg/$service/target"
            cp "$service/target/$service-1.0.0.jar" "deploy_pkg/$service/target/"
          done

          tar -czf deploy.tar.gz -C deploy_pkg .

      - name: Prepare server and Swap memory
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SSH_HOST }}
          username: ${{ secrets.SSH_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          port: 49351
          timeout: 60s
          command_timeout: 3m
          script: |
            # Создаем 4GB Swap, если его еще нет, чтобы Java-сервисы не вешали сервер
            if [ ! -f /swapfile ]; then
              fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
              chmod 600 /swapfile
              mkswap /swapfile
              swapon /swapfile
              echo '/swapfile none swap sw 0 0' >> /etc/fstab
            else
              swapon /swapfile || true
            fi

            mkdir -p /var/www/EboGrid

      - name: Upload archive to server
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.SSH_HOST }}
          username: ${{ secrets.SSH_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          port: 49351
          timeout: 90s
          source: "deploy.tar.gz"
          target: "/var/www/EboGrid"

      - name: Extract and start Docker containers
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SSH_HOST }}
          username: ${{ secrets.SSH_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          port: 49351
          timeout: 60s
          command_timeout: 15m
          script: |
            set -e
            cd /var/www/EboGrid

            # 1. Сначала распаковываем свежие файлы (включая docker-compose.yml)
            tar -xzf deploy.tar.gz
            rm -f deploy.tar.gz

            # 2. Удаляем старые контейнеры, если они остались от прошлых запусков
            docker rm -f discovery-server config-server pokemon-service user-service world-service battle-service api-gateway evogrid-postgres 2>/dev/null || true

            # 3. Генерируем .env файл (кавычки вокруг EOF — чтобы bash ничего не подставлял)
            cat <<'EOF' > .env
            POSTGRES_USER=postgres
            POSTGRES_PASSWORD=postgres
            POSTGRES_DB=postgres
            USER_DB_NAME=user_db
            POKEMON_DB_NAME=pokemon_db
            WORLD_DB_NAME=world_db
            BATTLE_DB_NAME=battle_db
            JWT_SECRET=EvoGridSuperSecretKeyForJwtSigning2026CloudMvpProject!
            EOF
            echo "YANDEX_MAPS_API_KEY=${{ secrets.YANDEX_MAPS_API_KEY }}" >> .env

            # 4. Собираем образы и запускаем всё одной командой.
            #    Порядок старта задают depends_on + healthcheck в docker-compose.yml,
            #    --wait ждёт, пока сервисы с healthcheck станут healthy.
            docker compose build
            if ! docker compose up -d --remove-orphans --wait --wait-timeout 420; then
              echo "::error::Сервисы не поднялись. Последние логи:"
              docker compose ps -a
              for s in discovery-server config-server pokemon-service user-service world-service battle-service api-gateway; do
                echo "===== $s ====="
                docker compose logs --tail=60 "$s" || true
              done
              exit 1
            fi

            docker image prune -f
            docker compose ps

            # 5. Проверяем, что шлюз отвечает
            for i in $(seq 1 30); do
              if curl -fsS -o /dev/null http://127.0.0.1:8080/; then echo "api-gateway OK"; exit 0; fi
              sleep 5
            done
            echo "::error::api-gateway не отвечает на :8080"
            docker compose logs --tail=100 api-gateway
            exit 1
